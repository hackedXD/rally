# Copy to deploy/.env ON THE SERVER and fill in. Never committed, never
# rsynced from a laptop.

# The hostname Caddy will get a certificate for, and the origin every QR code
# and invite link is built from. It must already point at this box's IP.
#
# No domain? `<your-ip-with-dashes>.sslip.io` resolves to that IP with no DNS
# setup at all, and Let's Encrypt will issue for it:
#   RALLY_DOMAIN=45-76-12-34.sslip.io
RALLY_DOMAIN=

# Commentary. Both optional: with neither, the offline writer and the browser's
# own voice take over and nothing degrades except the quality of the jokes.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Concurrent TTS requests allowed against the key, process-wide. The free tier
# admits two; over the limit, lines are retried and then fall back to the
# browser's voice.
ELEVENLABS_CONCURRENCY=3
