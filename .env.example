# Rally server configuration. Copy to .env — never commit the real file.
PORT=8787
HOST=0.0.0.0

# Serve the built display/controller bundles from the Node server (production).
# In dev, leave unset and use the Vite dev servers.
RALLY_SERVE_STATIC=

# Public origin used when building the controller QR code.
# Set this to your tunnel/deployed HTTPS origin, e.g. https://rally.example.dev
# Leave blank to auto-derive from the request Host header.
RALLY_PUBLIC_ORIGIN=

# ── AI commentary (entirely optional) ──────────────────────────────────────────
# With no keys set, Rally uses the built-in offline commentator: a local
# template/markov writer plus browser speech synthesis. The game is fully
# playable and commentated without any API access.

# Google Gemini — text layer.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_LIVE=gemini-3.6-flash

# ElevenLabs — voice layer.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Force the offline providers even if keys are present (useful for rehearsal).
RALLY_FORCE_OFFLINE_AI=
